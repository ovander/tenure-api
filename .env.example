# Copy to .env (git-ignored) for local development. Every value here is a
# dev-only placeholder. In production the values come from the environment.
TENURE_HTTP_ADDR=127.0.0.1:8080
TENURE_DB_URL=postgres://tenure_api:dev-only-api@localhost:5432/tenure
TENURE_JOBS_DB_URL=postgres://tenure_jobs:dev-only-jobs@localhost:5432/tenure
TENURE_MIGRATE_DB_URL=postgres://tenure_migrate:dev-only-migrate@localhost:5432/tenure
# Socrate (RENT-BE-001 §4): paste here the block Socrate's console gives for the
# application (Q-99); the values below are placeholders. tenure is its
# confidential client, redirect URI <TENURE_PUBLIC_URL>/bff/callback, PKCE on.
# The audience is SOCRATE_CLIENT_ID unless SOCRATE_AUDIENCE is set.
# SOCRATE_BASE_URL, SOCRATE_ADMIN_BASE_URL and SOCRATE_APP_ID are not used.
SOCRATE_ISSUER=http://localhost:9090
SOCRATE_JWKS_URL=http://localhost:9090/.well-known/jwks.json
SOCRATE_CLIENT_ID=replace-with-the-tenure-client-id
SOCRATE_CLIENT_SECRET=replace-with-the-tenure-client-secret
# tenure's own: the Socrate role that makes a caller an admin.
TENURE_SOCRATE_ADMIN_ROLE=admin
TENURE_PUBLIC_URL=http://127.0.0.1:8080
# 32 random bytes in base64, e.g. openssl rand -base64 32; dev only, never reuse.
TENURE_SESSION_KEY=replace-with-openssl-rand-base64-32
TENURE_STEP_UP_MAX_AGE=5m
# Archive (docker-compose.dev.yml `archive`, bucket created by `archive-init`).
TENURE_S3_ENDPOINT=localhost:9000
TENURE_S3_REGION=us-east-1
TENURE_S3_BUCKET=tenure-dev
TENURE_S3_ACCESS_KEY=dev-only-archive
TENURE_S3_SECRET_KEY=dev-only-archive-secret
TENURE_S3_INSECURE=true
TENURE_PDF_ENGINE_URL=http://127.0.0.1:3000
TENURE_CLAMAV_ADDR=127.0.0.1:3310
# Mailpit catches the e-mails (http://127.0.0.1:8025).
TENURE_SMTP_ADDR=127.0.0.1:1025
TENURE_SMTP_FROM=no-reply@tenure.localhost
# TENURE_IRL_SOURCE_URL defaults to the INSEE BDM series of the IRL.
TENURE_LOG_LEVEL=info
# TENURE_TRUSTED_PROXIES=127.0.0.1
