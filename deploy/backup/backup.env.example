# /etc/tenure/backup.env — owner root:tenure-backup, mode 0640. Placeholders only.
TENURE_BACKUP_DB_URL=postgres://tenure_backup:<set-me>@127.0.0.1:5432/tenure?sslmode=verify-full
TENURE_BACKUP_AGE_RECIPIENT=age1<set-me>
TENURE_BACKUP_BUCKET=s3://tenure-backups/db
TENURE_BACKUP_ENDPOINT=https://s3.fr-par.scw.cloud
AWS_DEFAULT_REGION=fr-par
AWS_ACCESS_KEY_ID=<set-me>
AWS_SECRET_ACCESS_KEY=<set-me>
