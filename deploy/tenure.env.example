# /etc/tenure/tenure.env — owner root:tenure, mode 0640. Every TENURE_* value
# is validated at start; tenure refuses to start on a missing or malformed one.
# The values below are placeholders: real secrets live only on the host.
TENURE_HTTP_ADDR=127.0.0.1:8080
TENURE_PUBLIC_URL=https://tenure.example.fr
TENURE_TRUSTED_PROXIES=127.0.0.1/32
TENURE_LOG_LEVEL=info

# PostgreSQL 17 on the encrypted volume, over TLS (deploy/sql/roles.sql).
TENURE_DB_URL=postgres://tenure_api:<set-me>@127.0.0.1:5432/tenure?sslmode=verify-full
TENURE_JOBS_DB_URL=postgres://tenure_jobs:<set-me>@127.0.0.1:5432/tenure?sslmode=verify-full
TENURE_MIGRATE_DB_URL=postgres://tenure_migrate:<set-me>@127.0.0.1:5432/tenure?sslmode=verify-full

# Socrate (RENT-BE-001 §4): tenure is its confidential client.
# The block Socrate's console gives for the application goes here as it is
# (Q-99); the audience is SOCRATE_CLIENT_ID unless SOCRATE_AUDIENCE is set.
# SOCRATE_BASE_URL, SOCRATE_ADMIN_BASE_URL and SOCRATE_APP_ID are not used.
SOCRATE_ISSUER=https://socrate.example.fr
SOCRATE_JWKS_URL=https://socrate.example.fr/.well-known/jwks.json
SOCRATE_CLIENT_ID=<set-me>
SOCRATE_CLIENT_SECRET=<set-me>
TENURE_SOCRATE_ADMIN_ROLE=tenure-admin
# 32 random bytes, base64: openssl rand -base64 32
TENURE_SESSION_KEY=<set-me>
TENURE_STEP_UP_MAX_AGE=5m

# Archive bucket, Scaleway fr-par, versioning and object lock (OD-04).
TENURE_S3_ENDPOINT=s3.fr-par.scw.cloud
TENURE_S3_REGION=fr-par
TENURE_S3_BUCKET=tenure-archive
TENURE_S3_ACCESS_KEY=<set-me>
TENURE_S3_SECRET_KEY=<set-me>

# Sidecars on the loopback (deploy/sidecars.compose.yml).
TENURE_PDF_ENGINE_URL=http://127.0.0.1:3000
TENURE_CLAMAV_ADDR=127.0.0.1:3310

# E-mail. TENURE_IRL_SOURCE_URL defaults to the INSEE BDM series of the IRL.
TENURE_SMTP_ADDR=smtp.example.fr:587
TENURE_SMTP_USERNAME=tenure
TENURE_SMTP_PASSWORD=<set-me>
TENURE_SMTP_FROM=no-reply@example.fr

